{
    "version": "0.2.0",
    "configurations": [

        {
            "name": ".NET Core Launch BFDR.CLI",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-cli",
            "enableStepFiltering": false,
            "program": "${workspaceFolder}/projects/BFDR.CLI/bin/Debug/netcoreapp6.0/BFDR.CLI",
            "args": ["2ijecontent",
                    "birth",
                "${workspaceFolder}/projects/BFDR.CLI/vbNatRecord.json"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}